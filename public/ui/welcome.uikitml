<style>
  .panel-root { flex-direction: column; width: 420px; }
  .panel-content { flex-direction: column; gap: 7px; padding: 22px; }
  .eyebrow { color: #b0306a; font-size: 14px; font-weight: 700; letter-spacing: 1.4px; }
  .eyebrow:dark { color: #ff5fa2; }
  .heading { color: #1c1d20; font-size: 30px; font-weight: 700; line-height: 36px; }
  .heading:dark { color: #fafaf7; }
  .body { color: #3a3b40; font-size: 19px; line-height: 26px; }
  .body:dark { color: #dddfe3; }
  .button { justify-content: flex-start; margin-left: 22px; margin-right: 22px; margin-bottom: 22px; }
  .button-label { transform-translate-y: 1px; }
  .hint { color: #5a5c63; font-size: 15px; line-height: 20px; margin-left: 26px; margin-right: 22px; margin-bottom: 18px; margin-top: -10px; }
  .hint:dark { color: #a9abb3; }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">JAM ALONG</div>
    <div class="heading">Play with the band</div>
    <div class="body">1. Press Play to start a song.</div>
    <div class="body">2. Tap the keys, or switch to Drums.</div>
    <div class="body">Every key fits the song, so just play.</div>
  </div>
  <Button id="import-button" class="button" variant="secondary">
    <ButtonIcon>
      <Music></Music>
    </ButtonIcon>
    <ButtonLabel class="button-label">Import your own song</ButtonLabel>
  </Button>
  <div id="import-hint" class="hint">MP3, M4A or WAV, or drop a file here</div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter VR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
